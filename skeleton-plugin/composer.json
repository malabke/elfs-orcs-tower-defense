{
    "name": "jumphp-plugins/skeleton-plugin",
    "type": "jumphp-ide-plugin",
    "description": "Lists the TODO and FIXME comments of the project, warns about FIXME, completes @todo.",
    "license": "MIT",
    "require-dev": {
        "jumphp/ide": "*"
    },
    "repositories": [
        { "type": "path", "url": "../../ide", "options": { "symlink": true } }
    ],
    "autoload": {
        "psr-4": { "JumphpPlugins\\SkeletonPlugin\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "JumphpPlugins\\SkeletonPlugin\\Tests\\": "tests/" }
    },
    "extra": {
        "jumphp-ide": {
            "id": "skeleton-plugin",
            "name": "TODO Finder",
            "version": "0.1.0",
            "class": "JumphpPlugins\\SkeletonPlugin\\TodoPlugin"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": { "sort-packages": true }
}
