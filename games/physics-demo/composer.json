{
    "name": "jumphp-games/physics-demo",
    "description": "The example game of the physics engine extension",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.2",
        "jumphp/engine": "@dev",
        "jumphp/physics": "@dev"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../../extensions/physics"
        },
        {
            "type": "path",
            "url": "../../engine"
        },
        {
            "type": "vcs",
            "url": "https://github.com/davidnurdin/php-wasm-network"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "App\\": "src/",
            "App\\Extensions\\Physics\\": "../../extensions/physics/doc/samples/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "platform-check": false
    }
}
