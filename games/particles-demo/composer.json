{
    "name": "jumphp-games/particles-demo",
    "description": "PARTICLES: the example game of the jumphp/particles engine extension",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.2",
        "jumphp/engine": "@dev",
        "jumphp/particles": "@dev"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../../extensions/particles"
        },
        {
            "type": "path",
            "url": "../../engine"
        },
        {
            "type": "vcs",
            "url": "https://github.com/davidnurdin/php-wasm-network"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "App\\": "src/",
            "App\\Extensions\\Particles\\": "../../extensions/particles/doc/samples/"
        }
    },
    "config": {
        "sort-packages": true,
        "platform-check": false
    }
}
