{
    "name": "jumphp-games/dialogue-demo",
    "description": "The example game of the dialogue engine extension",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.2",
        "jumphp/engine": "@dev",
        "jumphp/dialogue": "@dev"
    },
    "repositories": [
        { "type": "path", "url": "../../extensions/dialogue" },
        { "type": "path", "url": "../../engine" },
        { "type": "vcs", "url": "https://github.com/davidnurdin/php-wasm-network" }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": { "App\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "Tests\\": "tests/" }
    },
    "config": {
        "sort-packages": true,
        "platform-check": false
    }
}
